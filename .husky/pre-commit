# Format only the files staged for this commit, then re-stage them.
# Formatting the whole repo sweeps unrelated files into the commit.
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR)" ]; then
  git diff --cached --name-only --diff-filter=ACMR -z |
    xargs -0 yarn prettier --ignore-unknown --write
  git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 git add
fi

yarn lint
